<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        style="@style/SYSUER.AppBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!--<com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:transitionName="miniapp"
            app:layout_scrollFlags="scroll|enterAlways"
            app:navigationIcon="?homeAsUpIndicator" />-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/last"
                style="@style/Widget.Material3Expressive.Button.IconButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="?attr/homeAsUpIndicator" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/term"
                style="@style/Widget.Material3Expressive.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:text="@string/term" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/today"
                style="@style/Widget.Material3Expressive.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:minWidth="0dp"
                android:text="@string/today" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/weekTime"
                style="@style/Widget.Material3Expressive.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="2dp"
                android:text="@string/week_range" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/next"
                style="@style/Widget.Material3Expressive.Button.IconButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:rotation="180"
                app:icon="?attr/homeAsUpIndicator" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/week"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/month"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="?attr/colorSurfaceDim"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?colorSurfaceContainer"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <GridLayout
            android:id="@+id/day"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="8"
            android:orientation="vertical"
            android:rowCount="11" />
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:transitionName="miniapp"
        app:backgroundTint="#0000"
        app:fabAlignmentMode="end"
        app:fabAnimationMode="slide"
        app:hideOnScroll="true"
        app:layout_behavior="com.google.android.material.bottomappbar.BottomAppBar$Behavior"
        app:navigationIcon="@drawable/ic_nav_back_rounded"
        app:navigationIconTint="@null" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/export"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/export"
        app:layout_anchor="@id/toolbar"
        app:srcCompat="@drawable/export" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>