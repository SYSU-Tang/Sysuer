<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:id="@+id/handler"
        style="@style/Widget.Material3.BottomSheet.DragHandle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/description_card"
        style="@style/Widget.Material3.CardView.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/horizontal_margin"
        android:layout_marginBottom="@dimen/vertical_margin"
        app:contentPadding="@dimen/content_padding"
        app:layout_constraintBottom_toTopOf="@id/service_action_grid"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/handler">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textIsSelectable="true" />
    </com.google.android.material.card.MaterialCardView>

    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/service_action_grid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/horizontal_margin"
        android:layout_marginVertical="@dimen/vertical_margin"
        app:constraint_referenced_ids="guide,collect,feedback,delete,order,add_to_dashboard,add_to_launcher,open_as_url"
        app:flow_horizontalBias="0"
        app:flow_horizontalGap="@dimen/horizontal_gap"
        app:flow_horizontalStyle="packed"
        app:flow_verticalGap="@dimen/vertical_gap"
        app:flow_wrapMode="chain2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/description_card" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/collect"
        style="@style/Widget.Material3Expressive.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/collect"
        app:icon="@drawable/like" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/feedback"
        style="@style/Widget.Material3Expressive.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/feedback"
        app:icon="@drawable/feedback" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/delete"
        style="@style/Widget.Material3Expressive.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/delete"
        android:visibility="gone"
        app:icon="@drawable/delete" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/order"
        style="@style/Widget.Material3Expressive.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/service_order"
        app:icon="@drawable/menu" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/guide"
        style="@style/Widget.Material3Expressive.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/guide"
        app:icon="@drawable/book" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/add_to_dashboard"
        style="@style/Widget.Material3Expressive.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_to_dashboard"
        app:icon="@drawable/add" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/add_to_launcher"
        style="@style/Widget.Material3Expressive.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_to_launcher"
        app:icon="@drawable/add" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/open_as_url"
        style="@style/Widget.Material3Expressive.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/open_as_url"
        app:icon="@drawable/export" />
</androidx.constraintlayout.widget.ConstraintLayout>