<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/preview_navigation"
    app:startDestination="@id/preview_fragment">
    <fragment
        android:id="@+id/preview_fragment"
        android:name="com.sysu.edu.academic.CourseSelectionPreviewFragment"
        android:label="@string/preview">
        <action
            android:id="@+id/preview_to_filter"
            app:destination="@id/filter_fragment" />
    </fragment>
    <fragment
        android:id="@+id/filter_fragment"
        android:name="com.sysu.edu.academic.CourseSelectionFilterFragment"
        android:label="@string/filter">
        <argument
            android:name="course_selection_value_filter"
            android:defaultValue="@null"
            app:argType="com.sysu.edu.academic.CourseFilterValueData"
            app:nullable="true" />
        <argument
            android:name="course_selection_name_filter"
            android:defaultValue="@null"
            app:argType="com.sysu.edu.academic.CourseFilterNameData"
            app:nullable="true" />
    </fragment>
</navigation>